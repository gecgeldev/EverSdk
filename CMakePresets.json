{
  "$schema": "https://cmake.org/cmake/help/latest/_downloads/3e2d73bff478d88a7de0de736ba5e361/schema.json",
  "version": 8,
  "configurePresets": [
    {
      "name": "debug",
      "inherits": ["release"],
      "cacheVariables": {
        "EM_ENABLE_ASSERTING": true,
        "EM_ENABLE_DEBUGGING": true,
        "EM_ENABLE_OPTIMIZING": false,
        "EM_ENABLE_PROFILING": true
      }
    },
    {
      "name": "profile",
      "inherits": ["release"],
      "cacheVariables": {
        "EM_ENABLE_PROFILING": true
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "EM_ENABLE_ASSERTING": false,
        "EM_ENABLE_DEBUGGING": false,
        "EM_ENABLE_OPTIMIZING": true,
        "EM_ENABLE_PROFILING": false,
        "EM_PRESET": "${presetName}",
        "EM_SETUP": "$env{EVER_SDK_ROOT}/cmake/Setup.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "profile",
      "configurePreset": "profile"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ]
}
